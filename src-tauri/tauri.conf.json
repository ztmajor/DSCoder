{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dscoder",
  "version": "0.1.0",
  "identifier": "io.github.ztmajor.dscoder",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "dscoder",
        "width": 1280,
        "height": 800,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/dsh-bottom-info-bar/**/*",
      "resources/dsh-tabs-terminal/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
